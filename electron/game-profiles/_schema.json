{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checkpoint Game Profile v2",
  "type": "object",
  "required": ["schemaVersion", "gameDomain", "displayName", "rootFolders", "rootFiles"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "gameDomain": { "type": "string", "pattern": "^[a-z0-9-]{2,80}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "engine": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "executable": { "type": "string" },
    "detection": {
      "type": "object",
      "properties": {
        "executableCandidates": { "type": "array", "items": { "type": "string" } },
        "steamAppIds": { "type": "array", "items": { "type": "integer" } },
        "gogIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rootFolders": { "type": "array", "items": { "type": "string" } },
    "rootFiles": { "type": "array", "items": { "type": "string" } },
    "routingRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "targetPath"],
        "properties": {
          "name": { "type": "string" },
          "condition": {
            "type": "object",
            "properties": {
              "extension": { "type": "string" },
              "rootRelative": { "type": "boolean" }
            }
          },
          "targetPath": { "type": "string" }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "preferredMethod": { "enum": ["hardlink", "copy", "symlink"] },
        "fallback": { "enum": ["hardlink", "copy", "symlink"] }
      }
    },
    "installRules": {
      "type": "object",
      "properties": {
        "allowRootFallback": { "type": "boolean" },
        "forbiddenPaths": { "type": "array", "items": { "type": "string" } },
        "maxFileCount": { "type": "integer" },
        "maxEntryBytes": { "type": "integer" }
      }
    }
  }
}
